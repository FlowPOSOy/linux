# Posbank ACT 1560 (RK3399) on top of arm64 defconfig:
#   make ARCH=arm64 LLVM=1 defconfig act1560.config
# Boot-critical drivers are built in so a bare initramfs is enough for bring-up.

CONFIG_LOCALVERSION="-act1560"

# PMIC, regulators, RTC
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_REGULATOR_PWM=y
CONFIG_RTC_DRV_RK808=y
CONFIG_RTC_DRV_HYM8563=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_THERMAL=y

# Storage
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_PHY_ROCKCHIP_EMMC=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PWRSEQ_SIMPLE=y

# Display: eDP panel + mini-DP, GPU
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_ANALOGIX_DP=y
CONFIG_ROCKCHIP_CDN_DP=y
CONFIG_DRM_DISPLAY_DP_AUX_BUS=y
CONFIG_DRM_PANEL_EDP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM_PANFROST=m
CONFIG_EXTCON=y
CONFIG_EXTCON_DP_GPIO=y
CONFIG_PHY_ROCKCHIP_TYPEC=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# USB
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_STORAGE=y

# Network: Realtek PCIe NIC, AP6256 Wi-Fi/BT
CONFIG_PCIE_ROCKCHIP_HOST=y
CONFIG_PHY_ROCKCHIP_PCIE=y
CONFIG_R8169=y
CONFIG_BRCMFMAC=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_SERIAL_DEV_BUS=y

# Serial ports (console on uart2)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_NR_UARTS=8
CONFIG_SERIAL_8250_RUNTIME_UARTS=8

# Userspace GPIO (cash drawer)
CONFIG_GPIO_CDEV=y

# Initramfs / bring-up
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Android
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_PSI=y
CONFIG_USERFAULTFD=y
CONFIG_EROFS_FS=y
CONFIG_F2FS_FS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_BLK_DEV_DM=y
CONFIG_MD=y
CONFIG_DM_VERITY=y
# dm-user and incremental-fs are Android Common Kernel only (not in mainline)
